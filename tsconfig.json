  "compilerOptions": {
    "module": "NodeNext",
    "target": "es2022",
    "outDir": "./",
    "rootDir": "./src",
    "moduleResolution":"NodeNext",
    "declaration": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "./src/**/*"
  ],
  "exclude": ["./node_modules"]
}
